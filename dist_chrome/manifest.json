{
  "manifest_version": 3,
  "name": "What's That?",
  "version": "0.0.0",
  "description": "Lightweight LLM Queries for your Curiosities",
  "icons": {
    "32": "public/icon-32.png",
    "48": "public/icon-48.png"
  },
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_icon": "public/icon-48.png",
    "default_title": "What's That?",
    "default_popup": "src/pages/popup/index.html"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.tsx-loader-C8_ETjry.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "<all_urls>"
      ],
      "css": [
        "contentStyle.css",
        "assets/index-RbqGSM27.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [],
      "resources": [
        "public/contentStyle.css",
        "public/icon-128.png",
        "public/icon-48.png",
        "public/icon-32.png"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "<all_urls>",
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "assets/index-GLTT5uTQ.js",
        "assets/index.tsx-VrRV8NmA.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  }
}
